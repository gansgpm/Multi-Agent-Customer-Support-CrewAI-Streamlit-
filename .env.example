# ------------------------------------------------------------------
# Copy this file to .env and paste your real keys there.
# .env is listed in .gitignore, so it is NEVER pushed to GitHub.
# This .env.example file (placeholders only) is safe to commit.
# ------------------------------------------------------------------

# OpenAI key -> https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key

# Serper key (web search) -> https://serper.dev
SERPER_API_KEY=your-serper-key

# Optional: model used by all three agents (default: gpt-4o-mini)
OPENAI_MODEL_NAME=gpt-4o-mini

# Stops CrewAI's first-run "view your traces?" terminal prompt,
# which can otherwise pause the crew for ~20 seconds.
CREWAI_TRACING_ENABLED=false

# Optional: opt out of CrewAI anonymous telemetry
OTEL_SDK_DISABLED=true
